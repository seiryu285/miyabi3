<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>雅 -MIYABI- | 記憶の円環</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hachi+Maru+Pop&family=Shippori+Mincho&display=swap" rel="stylesheet">
    <style>
        :root {
            --main-color: #2D2D2D;
            --accent-color: #B70033;
            --bg-color: #FAFAFA;
            --memory-size: 300px;
            --transition-duration: 0.6s;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: "Yu Mincho", "MS Mincho", serif;
            background-color: var(--bg-color);
            color: var(--main-color);
            overflow-x: hidden;
        }

        .header {
            position: fixed;
            top: 0;
            width: 100%;
            padding: 1rem;
            background-color: rgba(250, 250, 250, 0.95);
            z-index: 1000;
            display: flex;
            justify-content: space-between;
            align-items: center;
            backdrop-filter: blur(8px);
        }

        .logo {
            font-size: 2.5rem;
            text-decoration: none;
            color: var(--main-color);
            letter-spacing: 0.1em;
            font-family: 'Hachi Maru Pop', cursive;
            display: flex;
            flex-direction: column;
            align-items: center;
            line-height: 1;
        }

        .logo-text {
            margin: 0;
            transition: color 0.3s ease;
        }

        .logo-subtitle {
            font-size: 0.9rem;
            color: var(--accent-color);
            font-family: 'Shippori Mincho', serif;
            margin-top: -5px;
            letter-spacing: 0.2em;
        }

        .logo:hover .logo-text {
            color: var(--accent-color);
        }

        .nav-links {
            display: flex;
            gap: 3rem;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--main-color);
            font-size: 1rem;
            letter-spacing: 0.1em;
            position: relative;
            padding: 0.5rem 0;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            width: 0;
            height: 1px;
            bottom: 0;
            left: 0;
            background-color: var(--accent-color);
            transition: width 0.3s ease;
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        .memories-container {
            margin-top: 100px;
            padding: 2rem;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(var(--memory-size), 1fr));
            gap: 3rem;
            max-width: 1400px;
            margin-left: auto;
            margin-right: auto;
        }

        .memory-circle {
            width: var(--memory-size);
            height: var(--memory-size);
            margin: 0 auto;
            position: relative;
            cursor: pointer;
            transition: transform var(--transition-duration) ease;
            overflow: hidden;
        }

        .model-preview {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: 1;
        }

        .memory-frame {
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            overflow: hidden;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
        }

        .memory-frame::before {
            content: '';
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            border: 2px solid transparent;
            background: linear-gradient(45deg, var(--accent-color), transparent) border-box;
            -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
            mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            animation: rotate 10s linear infinite;
        }

        .memory-video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
            transition: transform var(--transition-duration) ease;
        }

        .memory-info {
            position: absolute;
            bottom: -60px;
            left: 50%;
            transform: translateX(-50%);
            text-align: center;
            opacity: 0;
            transition: opacity var(--transition-duration) ease;
        }

        .memory-circle:hover .memory-info {
            opacity: 1;
        }

        .memory-title {
            font-size: 1.2rem;
            margin-bottom: 0.5rem;
            color: var(--main-color);
        }

        .memory-description {
            font-size: 0.9rem;
            color: #666;
        }

        @keyframes rotate {
            from {
                transform: rotate(0deg);
            }
            to {
                transform: rotate(360deg);
            }
        }

        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.9);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 2000;
            opacity: 0;
            transition: opacity var(--transition-duration) ease;
        }

        .modal.show {
            opacity: 1;
        }

        .modal-content {
            width: 90%;
            max-width: 1200px;
            position: relative;
        }

        .modal-video {
            width: 100%;
            aspect-ratio: 16/9;
        }

        .close-button {
            position: absolute;
            top: -40px;
            right: 0;
            color: white;
            font-size: 2rem;
            cursor: pointer;
            background: none;
            border: none;
        }
    </style>
    <script type="importmap">
    {
        "imports": {
            "three": "https://cdn.skypack.dev/three@0.136.0",
            "three/examples/jsm/loaders/GLTFLoader.js": "https://cdn.skypack.dev/three@0.136.0/examples/jsm/loaders/GLTFLoader.js",
            "three/examples/jsm/controls/OrbitControls.js": "https://cdn.skypack.dev/three@0.136.0/examples/jsm/controls/OrbitControls.js"
        }
    }
    </script>
</head>
<body>
    <header class="header">
        <a href="index.html" class="logo">
            <span class="logo-text">雅</span>
            <span class="logo-subtitle">-MIYABI-</span>
        </a>
        <nav class="nav-links">
            <a href="about.html">ABOUT</a>
            <a href="gallery.html">GALLERY</a>
            <a href="model-gallery.html">ITEMS</a>
        </nav>
    </header>

    <div class="memories-container">
        <!-- 記憶の円環1 -->
        <div class="memory-circle" data-model="./assets/models1.glb">
            <div class="model-preview" id="preview1"></div>
            <div class="memory-frame">
                <video class="memory-video" muted loop playsinline>
                    <source src="path/to/your/video1.mp4" type="video/mp4">
                </video>
            </div>
            <div class="memory-info">
                <h3 class="memory-title">壱</h3>
                <p class="memory-description">伝統と現代が融合したモダンアート作品</p>
            </div>
        </div>

        <!-- 記憶の円環2 -->
        <div class="memory-circle" data-model="./assets/models2.glb">
            <div class="model-preview" id="preview2"></div>
            <div class="memory-frame">
                <video class="memory-video" muted loop playsinline>
                    <source src="path/to/your/video2.mp4" type="video/mp4">
                </video>
            </div>
            <div class="memory-info">
                <h3 class="memory-title">弐</h3>
                <p class="memory-description">日本の完璧さを表現した立体作品</p>
            </div>
        </div>

        <!-- 記憶の円環3 -->
        <div class="memory-circle" data-model="./assets/models3.glb">
            <div class="model-preview" id="preview3"></div>
            <div class="memory-frame">
                <video class="memory-video" muted loop playsinline>
                    <source src="path/to/your/video3.mp4" type="video/mp4">
                </video>
            </div>
            <div class="memory-info">
                <h3 class="memory-title">参</h3>
                <p class="memory-description">和のエッセンスを取り入れた現代アート</p>
            </div>
        </div>

        <!-- 記憶の円環4 -->
        <div class="memory-circle" data-model="./assets/models4.glb">
            <div class="model-preview" id="preview4"></div>
            <div class="memory-frame">
                <video class="memory-video" muted loop playsinline>
                    <source src="path/to/your/video4.mp4" type="video/mp4">
                </video>
            </div>
            <div class="memory-info">
                <h3 class="memory-title">四</h3>
                <p class="memory-description">現代の技術による伝統美の表現</p>
            </div>
        </div>
    </div>

    <!-- モーダルウィンドウ -->
    <div class="modal">
        <div class="modal-content">
            <button class="close-button">&times;</button>
            <video class="modal-video" controls>
                <source src="" type="video/mp4">
            </video>
        </div>
    </div>

    <script type="module">
        import * as THREE from 'three';
        import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
        import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

        // 3Dモデルプレビューを初期化
        const previewContainers = document.querySelectorAll('.model-preview');
        const scenes = [];
        const cameras = [];
        const renderers = [];
        const models = [];
        const controls = [];

        // メモリーサークルの要素取得
        const memoryCircles = document.querySelectorAll('.memory-circle');

        // 各プレビュー要素に3Dシーンをセットアップ
        previewContainers.forEach((container, index) => {
            // シーン作成
            const scene = new THREE.Scene();
            scene.background = new THREE.Color(0xf0f0f0);
            scenes.push(scene);

            // カメラ作成
            const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 100);
            camera.position.z = 3;
            cameras.push(camera);

            // レンダラー作成
            const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setSize(container.clientWidth, container.clientHeight);
            renderer.outputEncoding = THREE.sRGBEncoding;
            renderer.setPixelRatio(window.devicePixelRatio);
            container.appendChild(renderer.domElement);
            renderers.push(renderer);

            // 環境光追加
            const ambientLight = new THREE.AmbientLight(0xffffff, 0.7);
            scene.add(ambientLight);

            // 指向性ライト追加
            const directionalLight = new THREE.DirectionalLight(0xffffff, 0.8);
            directionalLight.position.set(1, 1, 1);
            scene.add(directionalLight);

            // コントロール作成（ホバー時のみ有効化）
            const control = new OrbitControls(camera, renderer.domElement);
            control.enableZoom = false;
            control.enablePan = false;
            control.enableRotate = false;
            control.autoRotate = true;
            control.autoRotateSpeed = 3;
            controls.push(control);

            // モデル参照用配列
            models.push(null);
        });

        // GLTFローダー作成
        const loader = new GLTFLoader();

        // 各メモリーサークルのモデルを読み込む
        memoryCircles.forEach((circle, index) => {
            const modelPath = circle.getAttribute('data-model');
            if (!modelPath) return;

            loader.load(
                modelPath,
                (gltf) => {
                    const model = gltf.scene;

                    // モデルのスケール調整
                    const box = new THREE.Box3().setFromObject(model);
                    const size = box.getSize(new THREE.Vector3()).length();
                    const scale = 2 / size;
                    model.scale.set(scale, scale, scale);

                    // モデルの位置調整（中心に配置）
                    box.setFromObject(model);
                    const center = box.getCenter(new THREE.Vector3());
                    model.position.x -= center.x;
                    model.position.y -= center.y;
                    model.position.z -= center.z;

                    scenes[index].add(model);
                    models[index] = model;
                },
                (xhr) => {
                    // 読み込み進捗（必要に応じて）
                },
                (error) => {
                    console.error('モデル読み込みエラー:', error);
                }
            );

            // ホバー時の挙動
            circle.addEventListener('mouseenter', () => {
                controls[index].enableRotate = true;
            });

            circle.addEventListener('mouseleave', () => {
                controls[index].enableRotate = false;
            });

            // クリック時の遷移
            circle.addEventListener('click', () => {
                // モデルビューアーに移動（モデル番号を渡す）
                const modelNumber = modelPath.split('/').pop().replace(/\D/g, '');
                window.location.href = `model-viewer.html?model=${modelNumber}`;
            });
        });

        // アニメーションループ
        function animate() {
            requestAnimationFrame(animate);

            controls.forEach((control, index) => {
                // 各シーンの自動回転更新
                control.update();

                // レンダリング
                if (renderers[index] && scenes[index] && cameras[index]) {
                    renderers[index].render(scenes[index], cameras[index]);
                }
            });
        }

        animate();

        // ウィンドウリサイズ時の処理
        window.addEventListener('resize', () => {
            previewContainers.forEach((container, index) => {
                const width = container.clientWidth;
                const height = container.clientHeight;

                cameras[index].aspect = width / height;
                cameras[index].updateProjectionMatrix();

                renderers[index].setSize(width, height);
            });
        });

        // 動画の自動再生
        const videos = document.querySelectorAll('.memory-video');
        videos.forEach(video => {
            video.play();
        });

        // 動画の自動再生制御
        const memoryCircles = document.querySelectorAll('.memory-circle');
        const modal = document.querySelector('.modal');
        const modalVideo = modal.querySelector('.modal-video');
        const closeButton = modal.querySelector('.close-button');

        // Intersection Observer for video autoplay
        const videoObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                const video = entry.target.querySelector('video');
                if (entry.isIntersecting) {
                    video.play();
                } else {
                    video.pause();
                }
            });
        }, { threshold: 0.5 });

        memoryCircles.forEach(circle => {
            videoObserver.observe(circle);

            // クリックイベントの追加
            circle.addEventListener('click', () => {
                const video = circle.querySelector('video');
                modalVideo.src = video.querySelector('source').src;
                modal.style.display = 'flex';
                setTimeout(() => modal.classList.add('show'), 10);
                modalVideo.play();
            });
        });

        // モーダルを閉じる処理
        function closeModal() {
            modal.classList.remove('show');
            setTimeout(() => {
                modal.style.display = 'none';
                modalVideo.pause();
                modalVideo.src = '';
            }, 600);
        }

        closeButton.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
        });

        // パフォーマンス最適化
        let resizeTimeout;
        window.addEventListener('resize', () => {
            if (resizeTimeout) clearTimeout(resizeTimeout);
            resizeTimeout = setTimeout(() => {
                // リサイズ時の処理をここに記述
            }, 100);
        });
    </script>
</body>
</html>